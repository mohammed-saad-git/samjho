# ==============================================================================
# Samjho Frontend Environment Variables (public by design)
# Copy this file to .env.local for local dev, and add the same two variables in
# Vercel -> Project Settings -> Environment Variables.
# NEVER commit .env.local or put real secret keys in this file.
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==============================================================================
# Supabase Edge Function Secrets (NEVER put these in .env.local or Vercel)
# Set them ONLY on Supabase using the CLI:
#   npx supabase secrets set GEMINI_API_KEY=your-gemini-api-key
#   npx supabase secrets set GEMINI_MODEL=gemini-3.8-flash
#   npx supabase secrets set ALLOWED_ORIGIN=https://your-app.vercel.app
#
# NEVER store or use SUPABASE_SERVICE_ROLE_KEY in client code, the repo, or Vercel.
# ==============================================================================
